HIPOTESE="preflightCacheFile rejeita o cache antes de qualquer checagem de assinatura; desviar o ramo de rejeicao permite o load"
# ${VAR-default}: so preenche se nao definido; variavel vazia na linha de
# comando continua vazia (ex.: BASE_IPSW= pula o diff).
IPSW_BIN="${IPSW_BIN-/Volumes/XcodeBuild/opt/ipsw}"
DSC_LOCAL="${DSC_LOCAL-/Volumes/XcodeBuild/dsc/27.2/24B119__iPhone18,2}"
